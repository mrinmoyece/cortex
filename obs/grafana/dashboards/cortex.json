{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Cortex agentic AI platform — LLM cost, latency, quality, and safety metrics",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "💰 Cost & Usage",
      "type": "row"
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 5 },
            { "color": "red", "value": 20 }
          ]},
          "unit": "currencyUSD",
          "decimals": 2
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["sum"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "title": "LLM Spend (1h)",
      "targets": [{ "expr": "increase(cortex_llm_cost_usd_total[1h])", "legendFormat": "USD" }],
      "type": "stat"
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["sum"] } },
      "title": "Total Tokens (1h)",
      "targets": [
        { "expr": "increase(cortex_llm_tokens_total{token_type=\"input\"}[1h])", "legendFormat": "Input" },
        { "expr": "increase(cortex_llm_tokens_total{token_type=\"output\"}[1h])", "legendFormat": "Output" }
      ],
      "type": "stat"
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1,
        "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null },
          { "color": "yellow", "value": 0.5 },
          { "color": "green", "value": 0.8 }
        ]}
      }},
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "title": "Cache Hit Rate",
      "targets": [{
        "expr": "rate(cortex_llm_cache_hits_total[10m]) / (rate(cortex_llm_cache_hits_total[10m]) + rate(cortex_llm_request_duration_seconds_count[10m]))",
        "legendFormat": "Hit Rate"
      }],
      "type": "stat"
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4, "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 4,
      "title": "Cost by Model (rate/min)",
      "targets": [{
        "expr": "rate(cortex_llm_cost_usd_total[5m]) * 60",
        "legendFormat": "{{ model }}"
      }],
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "⚡ Latency",
      "type": "row"
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 10,
      "title": "LLM Request Latency (p50/p95/p99)",
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(cortex_llm_request_duration_seconds_bucket[5m]))", "legendFormat": "p50 {{ model }}" },
        { "expr": "histogram_quantile(0.95, rate(cortex_llm_request_duration_seconds_bucket[5m]))", "legendFormat": "p95 {{ model }}" },
        { "expr": "histogram_quantile(0.99, rate(cortex_llm_request_duration_seconds_bucket[5m]))", "legendFormat": "p99 {{ model }}" }
      ],
      "type": "timeseries"
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 11,
      "title": "Agent Run Duration (p50/p95)",
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(cortex_agent_run_duration_seconds_bucket[10m]))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(cortex_agent_run_duration_seconds_bucket[10m]))", "legendFormat": "p95" }
      ],
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "title": "🎯 Quality & Evaluation",
      "type": "row"
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 0.70 },
            { "color": "green", "value": 0.85 }
          ]}
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 19 },
      "id": 20,
      "title": "Median Faithfulness Score",
      "targets": [{
        "expr": "histogram_quantile(0.50, rate(cortex_hallucination_score_bucket[30m]))",
        "legendFormat": "Faithfulness"
      }],
      "type": "stat"
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null }, { "color": "yellow", "value": 0.65 }, { "color": "green", "value": 0.80 }
        ]}
      }},
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 19 },
      "id": 21,
      "title": "Median Critic Score",
      "targets": [{ "expr": "histogram_quantile(0.50, rate(cortex_critic_score_bucket[30m]))", "legendFormat": "Score" }],
      "type": "stat"
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 0.1 }, { "color": "red", "value": 0.3 }
        ]}
      }},
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 19 },
      "id": 22,
      "title": "Critic Rejection Rate",
      "targets": [{
        "expr": "rate(cortex_critic_rejections_total[15m]) / rate(cortex_agent_runs_total[15m])",
        "legendFormat": "Rejection Rate"
      }],
      "type": "stat"
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "percentunit", "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 23,
      "title": "Faithfulness Score Over Time",
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(cortex_hallucination_score_bucket[30m]))", "legendFormat": "p50 faithfulness" },
        { "expr": "histogram_quantile(0.10, rate(cortex_hallucination_score_bucket[30m]))", "legendFormat": "p10 (worst decile)" }
      ],
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 103,
      "title": "🛡️ Safety",
      "type": "row"
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "id": 30,
      "title": "Safety Violations by Type",
      "targets": [{
        "expr": "increase(cortex_safety_violations_total[1h])",
        "legendFormat": "{{ violation_type }}"
      }],
      "type": "timeseries"
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "id": 31,
      "title": "Agent Runs by Status",
      "targets": [{
        "expr": "rate(cortex_agent_runs_total[10m])",
        "legendFormat": "{{ status }}"
      }],
      "type": "timeseries"
    }

  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["cortex", "llmops", "agents"],
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Cortex Platform",
  "uid": "cortex-platform-v1",
  "version": 1
}

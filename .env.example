# ─────────────────────────────────────────────────────────────────────────────
# Cortex environment configuration
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=local                  # local | staging | production
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-random-32-plus-char-string-in-production

# ── LLM Providers ─────────────────────────────────────────────────────────────
# Fill in at least ONE provider. Cortex will use the first available.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
COHERE_API_KEY=...                 # Required for reranking. Get free at cohere.com

# Model selection (change to claude-3-5-sonnet-20241022 or similar for Anthropic)
DEFAULT_MODEL=gpt-4o
FALLBACK_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-large

# ── Data stores ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=                  # Required for Qdrant Cloud

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_ENDPOINT=http://localhost:4317
PHOENIX_ENDPOINT=http://localhost:6006

# ── Budget controls ───────────────────────────────────────────────────────────
MAX_COST_PER_RUN_USD=2.00
MAX_TOKENS_PER_REQUEST=4096

# ── Safety ────────────────────────────────────────────────────────────────────
GUARDRAILS_ENABLED=true
PII_DETECTION_ENABLED=true
INJECTION_DETECTION_ENABLED=true

# ── API surface ───────────────────────────────────────────────────────────────
API_RATE_LIMIT_PER_MINUTE=60
# Bucket map is bounded because its key is caller-controlled.
API_RATE_LIMIT_MAX_BUCKETS=10000
# Run state is in-process; these bound it. See docs/LIMITATIONS.md.
API_MAX_TRACKED_RUNS=1000
API_RUN_RETENTION_SECONDS=3600
# Set this wherever port 8000 is routable: /metrics exposes model names,
# spend totals and run volumes. Prometheus must send it as a bearer token.
# METRICS_TOKEN=

# ── MCP ───────────────────────────────────────────────────────────────────────
MCP_TRANSPORT=stdio                # stdio | http | sse — containers need http
# execute_code runs a subprocess in this container with no isolation.
# Read docs/LIMITATIONS.md before turning this on.
CODE_EXECUTION_ENABLED=false
# Tools reachable over POST /api/v1/mcp/call. Every name must be a real tool;
# configuration refuses to load otherwise.
# MCP_HTTP_TOOL_ALLOWLIST=["search_knowledge","query_memory","query_data","synthesise"]
#
# Identity a STANDALONE cortex-mcp process acts as, for tools that touch a
# user's own data (query_memory). An MCP transport carries no authentication,
# so this is the operator declaring whose data a single-user stdio server may
# read - not a login. It is ignored on the http/sse transports, where one
# declared identity would serve every caller alike; reach those tools through
# POST /api/v1/mcp/call instead. Unset means query_memory refuses.
# MCP_PRINCIPAL_USER_ID=
# MCP_PRINCIPAL_TENANT_ID=default

# ── Agent graph ───────────────────────────────────────────────────────────────
# Suspends the run before the critic. There is no resume endpoint yet, so a
# suspended run stays suspended. See docs/LIMITATIONS.md.
HUMAN_REVIEW_BEFORE_CRITIC=false

# ── RAG ───────────────────────────────────────────────────────────────────────
# Upper bound on the in-process BM25 corpus.
RAG_MAX_INDEXED_CHUNKS=50000

# ── PII detection ─────────────────────────────────────────────────────────────
# Presidio's default entity set redacts ordinary words out of user goals, so
# it is restricted to this allowlist and confidence floor.
# PII_SCORE_THRESHOLD=0.5
# PII_ENTITIES=["CREDIT_CARD","CRYPTO","EMAIL_ADDRESS","IBAN_CODE","IP_ADDRESS","MEDICAL_LICENSE","PHONE_NUMBER","UK_NHS","US_BANK_NUMBER","US_ITIN","US_PASSPORT","US_SSN"]

# ── Local stack ───────────────────────────────────────────────────────────────
# Used by docker-compose for the Grafana admin account.
GRAFANA_ADMIN_PASSWORD=cortex
